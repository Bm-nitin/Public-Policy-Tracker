# Copy this file to .env and fill in real values. .env itself is gitignored
# and must never be committed.

# --- Required for AI fallback (chatbot works without it, with reduced
# functionality - see backend/config.py) ---
GEMINI_API_KEY=

# --- Optional overrides (safe to leave unset - defaults shown) ---
# GEMINI_MODEL=gemini-2.5-flash
# CORS_ORIGINS=*
# HOST=0.0.0.0
# PORT=5000

# --- Database (Phase 2 - optional; app runs fine with this unset) ---
# postgresql+psycopg selects the psycopg3 driver installed via
# requirements.txt. Replace with real credentials in your local .env only
# - never commit real values.
# DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/policy_tracker
